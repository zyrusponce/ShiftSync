# ShiftSync mobile app (Expo). Copy to .env and fill in.
#
# Only EXPO_PUBLIC_* values are built into the app, and anyone with the APK
# can read them. Never put keys or secrets here with that prefix.

# The ShiftSync API. Leave empty to run the on-device demo only.
#   Android emulator:  http://10.0.2.2:4000  (or http://localhost:4000 with `adb reverse tcp:4000 tcp:4000`)
#   Phone, same Wi-Fi: http://192.168.x.x:4000  (your computer's LAN address; Expo Go / dev builds only)
#   APK builds:        an https:// address (Android blocks plain http in release builds)
EXPO_PUBLIC_API_BASE_URL=

# Server-side secrets belong in server/.env, not here. The server can still
# read the older names below from this file if they are already present:
# VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY, VITE_google_gemini_api_key,
# VITE_GOOGLE_CLIENT_ID. Do not rename any of them to EXPO_PUBLIC_*.
