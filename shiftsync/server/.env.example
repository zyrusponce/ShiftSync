# ShiftSync API server. Copy to server/.env and fill in. Never commit .env.
# Values here take precedence over ../.env; real environment variables take
# precedence over both.

# --- Required -------------------------------------------------------------
# Supabase project URL and its publishable (anon) key. The API calls
# Supabase with each user's own access token, so row level security applies;
# no service-role key is needed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Optional: AI (OpenRouter, or Google AI Studio / Gemini) ----------------
# Without a key, explanations and email drafts use built-in templates.
# OpenRouter is used when its key is set; otherwise Gemini.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# --- Optional: Google Calendar + Gmail -------------------------------------
# All four are needed to enable Google. Use an OAuth client of type
# "Web application" and add GOOGLE_REDIRECT_URI to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be reachable by the phone's browser: https://your-api-host/api/google/callback
# (http://localhost:4000/api/google/callback works on an emulator/USB device with `adb reverse tcp:4000 tcp:4000`)
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# --- Server ---------------------------------------------------------------
# PORT=4000
# HOST=0.0.0.0
# Deep-link prefixes allowed to receive the Google sign-in result.
# APP_RETURN_URL_PREFIXES=shiftsync://,exp://
# Set to true when running behind a reverse proxy (Render, Railway, Fly...).
# TRUST_PROXY=false
