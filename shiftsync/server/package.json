{
  "name": "shiftsync-server",
  "version": "1.0.0",
  "private": true,
  "description": "ShiftSync API: scheduling, recovery, AI drafts, Gmail and Google Calendar.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3"
  }
}
